# Set by Vercel's Neon integration automatically (Storage → Connect Database → Neon)
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Admin dashboard password (replaces the "Admin Password" row in the Admin Settings sheet)
ADMIN_PASSWORD=change-me

# Long random string used to sign admin sessions — e.g. run: openssl rand -hex 32
SESSION_SECRET=
